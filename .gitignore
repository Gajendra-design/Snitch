# Dependencies (heavy folders created by npm/yarn)
node_modules/
*/node_modules/

# Environment variables & secrets (CRITICAL: contains DB passwords, API keys)
.env
.env.*
!.env.example

# Production build outputs
dist/
build/
*/dist/
*/build/

# Logs & debugging
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/
*.log

# OS & Editor specific files
.DS_Store
Thumbs.db
.vscode/
.idea/

# Local database files (if running MongoDB locally or SQLite)
*.sqlite
*.sqlite3